# DAIT 설정 키 목업. 실제 비밀값을 이 파일에 넣지 않는다.
# 구현 로직: pydantic-settings가 환경별 필수 키를 검증하고 secret을 로그에서 숨긴다.
# 테스트: 필수값 누락, 잘못된 URL, 운영 debug 활성화, secret repr 노출을 확인한다.
APP_ENV=
DATABASE_URL=
REDIS_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
LLM_API_KEY=
# xAI Grok (OpenAI 호환) — src/backend/src/dait/workers/ai_processor.py
XAI_API_KEY=
GROK_MODEL=grok-beta
XAI_BASE_URL=https://api.x.ai/v1
# Groq(OpenAI 호환) — 설정 시 XAI_API_KEY보다 우선 적용됨
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# 동시 summarize 호출을 하나의 chat 요청으로 묶는 배치 크기 (1=비활성, 최대 8)
GROK_BATCH_SIZE=4
# 동시에 LLM 처리를 기다리는 기사 상한 — 무료 티어 rate limit 완화용 페이싱
MAX_CONCURRENT_ARTICLES=4
# LLM chat 요청 사이의 최소 간격(초) — 무료 티어 rate limit 완화용 페이싱
LLM_MIN_REQUEST_INTERVAL_SECONDS=2.5
