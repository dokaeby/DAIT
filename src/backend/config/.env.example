# DAIT 설정 키 목업. 실제 비밀값을 이 파일에 넣지 않는다.
# 구현 로직: pydantic-settings가 환경별 필수 키를 검증하고 secret을 로그에서 숨긴다.
# 테스트: 필수값 누락, 잘못된 URL, 운영 debug 활성화, secret repr 노출을 확인한다.
APP_ENV=
DATABASE_URL=
REDIS_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
LLM_API_KEY=
# xAI Grok (OpenAI 호환) — src/backend/src/dait/workers/ai_processor.py
XAI_API_KEY=
GROK_MODEL=grok-beta
XAI_BASE_URL=https://api.x.ai/v1
