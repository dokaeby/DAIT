# DAIT backend 환경변수 명세. 실제 비밀값을 이 파일에 넣지 않는다.
# Settings(extra="ignore")이므로 아직 코드가 읽지 않는 키도 함께 둘 수 있다.

# 실행 모드: debug | release (기본 release, 알 수 없는 값은 시작 거부)
APP_ENV=
# 로컬: sqlite:///./dait.db / 서버: postgresql:// 또는 postgres:// (Supabase pooler URI)
DATABASE_URL=
# JWT access 토큰 서명 키. 32~256자, 필수
JWT_SECRET=
# access 토큰 수명(분, 1~1440) / refresh 토큰 수명(일, 1~90)
ACCESS_TOKEN_MINUTES=
REFRESH_TOKEN_DAYS=
# CORS 허용 출처 JSON 배열. 와일드카드 불가
CORS_ORIGINS=

# --- 후속 단계에서 사용할 예정 키 (현재 미사용) ---
REDIS_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
LLM_API_KEY=
