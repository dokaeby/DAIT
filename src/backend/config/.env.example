# DAIT backend 환경변수 명세. 실제 비밀값을 이 파일에 넣지 않는다.
# Settings(extra="ignore")이므로 아직 코드가 읽지 않는 키도 함께 둘 수 있다.

# 실행 모드: debug | release (기본 release, 알 수 없는 값은 시작 거부)
APP_ENV=
# 로컬: sqlite:///./dait.db / 서버: postgresql:// 또는 postgres:// (Supabase pooler URI)
DATABASE_URL=
# JWT access 토큰 서명 키. 32~256자, 필수
JWT_SECRET=
# access 토큰 수명(분, 1~1440) / refresh 토큰 수명(일, 1~90)
ACCESS_TOKEN_MINUTES=
REFRESH_TOKEN_DAYS=
# CORS 허용 출처 JSON 배열. 와일드카드 불가
CORS_ORIGINS=

# 외부 cron(cron-job.org) → POST /v1/internal/scheduler/tick 의 Authorization: Bearer 값.
# 비워 두면 tick 엔드포인트는 모든 요청을 401로 거절한다. JWT_SECRET과 다른 무작위 값을 쓴다.
SCHEDULER_TICK_SECRET=
# 카카오 '나에게 보내기' 최대 시도 횟수와 재시도 간격(초, JSON 배열). 팀 확정 전 기본값 3 / [60,300,900]
KAKAO_MAX_ATTEMPTS=
KAKAO_RETRY_BACKOFF_SECONDS=
# 카톡 메시지에 넣을 사이트 주소(예: https://<배포 도메인>)
PUBLIC_BASE_URL=

# --- 후속 단계에서 사용할 예정 키 (현재 미사용) ---
REDIS_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
LLM_API_KEY=
