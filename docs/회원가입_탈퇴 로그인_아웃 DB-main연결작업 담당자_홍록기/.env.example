# 비밀값을 넣지 않는다. 실제 값은 .env(Git 제외)나 배포 환경변수로 주입한다.
# 실행 모드: debug 또는 release. 비워 두면 release. 다른 값이면 서버가 시작되지 않는다.
APP_ENV=release
# 지금은 sqlite만 허용한다.
DATABASE_URL=sqlite:///./dait.db
# 허용할 프런트 출처 목록(JSON 배열). 와일드카드(*)는 거부된다.
CORS_ORIGINS=[]
# 토큰 서명 키. 32자 이상 무작위 문자열 필수(비어 있으면 서버가 시작되지 않는다).
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# access 토큰 유효 시간(분)과 refresh 토큰 유효 기간(일)
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
