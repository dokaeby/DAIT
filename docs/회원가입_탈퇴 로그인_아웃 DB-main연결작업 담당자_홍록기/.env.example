# 비밀값을 넣지 않는다. 실제 값은 .env(Git 제외)나 배포 환경변수로 주입한다.
# 실행 모드: debug 또는 release. 비워 두면 release. 다른 값이면 서버가 시작되지 않는다.
APP_ENV=release
# 지금은 sqlite만 허용한다.
DATABASE_URL=sqlite:///./dait.db
# 허용할 프런트 출처 목록(JSON 배열). 와일드카드(*)는 거부된다.
CORS_ORIGINS=[]
# 토큰 서명 키. 32자 이상 무작위 문자열 필수(비어 있으면 서버가 시작되지 않는다).
# 생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# access 토큰 유효 시간(분)과 refresh 토큰 유효 기간(일)
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# 이메일 2차 인증(로그인). 기본은 꺼짐이며 꺼져 있으면 아래 값은 쓰이지 않는다.
# true로 켜려면 아래 값이 모두 있어야 서버가 시작된다. 실제 값은 .env에만 적는다.
TWO_FACTOR_ENABLED=false
# 코드 해시에 섞는 서버 비밀 키(32자 이상 무작위 문자열). 생성 예는 JWT_SECRET과 같다.
# OTP_HASH_SECRET=
# Google SMTP: SMTP_USERNAME은 발신 계정, SMTP_APP_PASSWORD는 구글 "앱 비밀번호"(계정 비밀번호 아님)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_APP_PASSWORD=
# SMTP_FROM=
